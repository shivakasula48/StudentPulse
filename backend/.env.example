# StudentPulse AI Backend Environment Configuration

PROJECT_NAME="StudentPulse AI"
API_V1_STR="/api"

# JWT Authentication
SECRET_KEY="replace-with-a-very-long-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./studentpulse.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/studentpulse_db"

# AI Integration (Google Gemini API)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-4-hydrogen"

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
